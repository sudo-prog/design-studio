{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd artifacts/design-studio && pnpm build",
  "installCommand": "pnpm install",
  "outputDirectory": "artifacts/design-studio/dist/public",
  "framework": "vite",
  "env": {
    "BASE_PATH": "/"
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
