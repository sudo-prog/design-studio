{
  "framework": "vite",
  "buildCommand": "BASE_PATH=/ pnpm --filter design-studio build",
  "outputDirectory": "artifacts/design-studio/dist/public",
  "installCommand": "pnpm install --no-frozen-lockfile",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
